# ─────────────────────────────────────────────────────────────
# Trapotato Verify Server — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Node/pg connection string. Use the standard `postgresql://` scheme
# (NOT the SQLAlchemy `postgresql+asyncpg://` form).
# Special characters in the password must be URL-encoded:
#   #  -> %23     !  -> %21     @  -> %40     $  -> %24
# Example (password "X9mK7vQ2#Lp8Tz4!Rw3Nc6@Hy1Df5$Js"):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Dedicated schema for this app. All tables live here (NOT in the existing app DB).
DB_SCHEMA=trapotato

# Set to "require" if your Postgres enforces TLS, otherwise leave "disable".
DB_SSL=disable

# ── Admin authentication ──────────────────────────────────────
ADMIN_USERNAME=trapotato_admin
ADMIN_PASSWORD=change-me

# Secret used to sign admin session cookies. Use a long random string (>= 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── License verification API ──────────────────────────────────
# Optional shared secret. If set, the desktop app must send it in the
# `x-api-key` header on POST /api/license/verify. Leave blank to disable.
LICENSE_API_KEY=

# A machine is counted as an "online client" if it verified within this many minutes.
ONLINE_WINDOW_MINUTES=10

# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
